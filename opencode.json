{
    "$schema": "https://opencode.ai/config.json",
    "subagent_depth": 2,
    "provider": {
        "atomic": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Atomic LiteLLM",
            "options": {
                "baseURL": "https://litellm.atomicnuggetstudio.com/v1"
            },
            "models": {
                "auto": {
                    "name": "Auto"
                }
            }
        }
    },
    "model": "atomic/auto",
    "small_model": "atomic/auto",
    "agent": {
		"plan": {
            "description": "Cria planos detalhados sem modificar código.",
            "mode": "all",
            "steps": 20,
            "prompt": "{file:./agents/plan.md}",
            "permission": {
                "read": "allow",
                "edit": "deny",
                "external_directory": "allow",
                "bash": {
                    "*": "deny",
                    "echo *": "allow",
                    "ls *": "allow",
                    "grep *": "allow",
                    "find *": "allow",
                    "git log*": "allow",
                    "git status*": "allow",
                    "git diff*": "allow",
                    "git show*": "allow",
                    "cat *": "allow",
                    "pwd": "allow"
                }
            }
        },
        "build": {
            "description": "Implementa funcionalidades seguindo os padrões da Atomic.",
            "mode": "all",
            "steps": 50,
            "prompt": "{file:./agents/build.md}",
            "permission": {
                "read": "allow",
                "edit": "allow",
                "external_directory": "allow",
                "bash": {
                    "*": "deny",
                    "echo *": "allow",
                    "ls *": "allow",
                    "grep *": "allow",
                    "find *": "allow",
                    "cat *": "allow",
                    "pwd": "allow",
                    "mkdir *": "allow",
                    "node *": "allow",
                    "git log*": "allow",
                    "git status*": "allow",
                    "git diff*": "allow",
                    "git show*": "allow",
                    "git add *": "allow",
                    "dotnet*": "allow",
                    "npm*": "allow",
                    "npx*": "allow",
                    "yarn*": "allow",
                    "pnpm*": "allow",
                    "cargo*": "allow",
                    "make*": "allow",
                    "cmake*": "allow",
                    "gradle*": "allow",
                    "mvn*": "allow",
                    "python*": "allow",
                    "pytest*": "allow",
                    "pip*": "allow",
                    "go *": "allow",
                    "rustc*": "allow",
                    "gcc*": "allow",
                    "g++*": "allow"
                }
            }
        },
        "review": {
            "description": "Realiza revisão técnica das alterações.",
            "mode": "all",
            "steps": 15,
			"color": "#A855F7",
            "prompt": "{file:./agents/review.md}",
            "permission": {
                "read": "allow",
                "edit": "deny",
                "external_directory": "allow",
                "bash": {
                    "*": "deny",
                    "echo *": "allow",
                    "ls *": "allow",
                    "grep *": "allow",
                    "find *": "allow",
                    "git log*": "allow",
                    "git status*": "allow",
                    "git diff*": "allow",
                    "git show*": "allow",
                    "cat *": "allow",
                    "pwd": "allow"
                }
            }
        },
        "issue": {
            "description": "Agente orquestrador que analisa Issues e delega para Plan ou Build Agent.",
            "hidden": true,
            "mode": "primary",
            "steps": 30,
            "prompt": "{file:./agents/issue.md}",
            "permission": {
                "read": "allow",
                "edit": "deny",
                "external_directory": "allow",
                "bash": {
                    "*": "deny",
                    "echo *": "allow",
                    "ls *": "allow",
                    "grep *": "allow",
                    "find *": "allow",
                    "pwd": "allow",
                    "git log*": "allow",
                    "git status*": "allow",
                    "git diff*": "allow",
                    "git show*": "allow",
                    "node -e *": "allow"
                }
            }
        }
    }
}